# 飞书应用凭据
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书 Bitable (多维表格) 配置
# 表格 token（从表格 URL 中获取）
FEISHU_BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxxxxxxxx
# 数据表 ID
FEISHU_BITABLE_TABLE_ID=tblxxxxxxxxxxxxxxxx

# 飞书 Webhook 验证密钥（可选，用于事件订阅校验）
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_ENCRYPT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NAS 存储路径（Excel 文件保存目录）
NAS_OUTPUT_DIR=/mnt/nas/contracts/PO

# Flask 服务配置
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# 公司信息（出现在合同头部）
COMPANY_NAME=贵公司名称
COMPANY_ADDRESS=公司地址
COMPANY_TEL=公司电话
COMPANY_FAX=公司传真
COMPANY_EMAIL=公司邮箱
